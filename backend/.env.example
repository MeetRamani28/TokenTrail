# TokenTrail Backend Environment Configuration Template
# Mode: development | production | test
APP_ENV=development

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Database
# Development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./tokentrail.db
# Production (Supabase pooler): postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# CORS (comma-separated, NO trailing slashes, NEVER '*' in production)
CORS_ORIGINS=http://localhost:5173

# Clerk Authentication (JWT verification on /api/*)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Internal Scheduled Jobs Secret (for POST /internal/run-jobs)
INTERNAL_JOBS_TOKEN=dev_internal_jobs_token_change_in_production
